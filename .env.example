DB_USER=postgres
DB_PASSWORD=your-local-password-here
DATABASE_URL=Host=postgres;Port=5432;Database=crmdb;Username=postgres;Password=your-local-password-here
JWT_SECRET=your-jwt-secret-here
BREVO_API_KEY=your-brevo-key-here
# Azurite well-known dev account key, pointed at the azurite service on the compose network
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_KEY_VAULT_URI=https://your-vault.vault.azure.net/
VITE_API_BASE_URL=http://localhost:5000
# Help & support drawer: Contact support / Report a problem go here. Leave empty to hide them.
VITE_SUPPORT_EMAIL=
# Seeded SuperAdmin. Local dev only: the API refuses to start outside Development if the
# password is this example value. The first login forces a password change.
ADMIN_EMAIL=admin@crm.local
ADMIN_DEFAULT_PASSWORD=ChangeMe123!

# Deployed environment only (production App Service settings) — not needed for
# local Development, where appsettings.Development.json supplies http://localhost:3000.
# The API refuses to start outside Development if these are empty or point at localhost.
# Cors__AllowedOrigins__0=https://crm.example.org
# Frontend__BaseUrl=https://crm.example.org

# In-app CRM agent (docs/agent-spec.md §9). Off by default. Ollama needs no key; an
# openai-compatible provider (Groq, GitHub Models, OpenAI) needs AGENT_API_KEY, and the API
# refuses to start without it. Use seed data only with free tiers: they may train on prompts.
# Agent__Enabled=true
# Agent__Provider=openai-compatible
# Agent__Endpoint=https://api.groq.com/openai/v1/
# Agent__Model=openai/gpt-oss-120b
AGENT_API_KEY=your-agent-provider-key-here
# Production only: the API refuses to start with the agent on unless the Agent__Endpoint host is listed here.
# Agent__AllowedProductionProviders__0=api.anthropic.com
# RateLimiting__Agent__PermitLimit=20
# RateLimiting__Agent__WindowMinutes=10

# CRM MCP server (docs/mcp-spec.md). Development/demo only, seed data only:
# the API refuses to start in Production with this on.
# Mcp__Enabled=true
# Counts every /mcp request (initialize, tools/list and tools/call).
# RateLimiting__Mcp__PermitLimit=60
# RateLimiting__Mcp__WindowMinutes=10

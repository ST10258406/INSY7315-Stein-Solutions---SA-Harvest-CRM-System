{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "Auth": {
    "RefreshCookie": {
      "Secure": false
    }
  },
  "Jwt": {
    "SigningKey": "local-development-signing-key-needs-to-be-at-least-256-bits-long!"
  },
  "Azure": {
    "BlobStorage": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ContainerName": "donor-documents"
    }
  }
}
